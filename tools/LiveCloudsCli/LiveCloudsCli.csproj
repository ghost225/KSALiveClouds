<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the KSALiveClouds fetch/build pipeline outside KSA (no game assemblies needed) and writes previews. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">$(HOME)/Games/KSA/current</KsaDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PureHDF" Version="2.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../KSALiveClouds/Config.cs;../../KSALiveClouds/Gmgsi.cs;../../KSALiveClouds/Coverage.cs;../../KSALiveClouds/Ktx2.cs;../../KSALiveClouds/CubeBuilder.cs;../../KSALiveClouds/Pipeline.cs" />
  </ItemGroup>

</Project>
